[Unit]
Description=upcoming.studio HAT display (clock / service status)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/hat
ExecStart=/home/pi/.venv/hat/bin/python /home/pi/hat/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
