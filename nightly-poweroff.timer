[Unit]
Description=Power off at 00:00 local time

[Timer]
OnCalendar=*-*-* 00:00:00
# Persistent=false is essential: with it true, a Pi powered on at (say) 09:00
# would see the missed midnight trigger and immediately shut itself down again.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
